# Copie este arquivo para .env e preencha. NUNCA suba o .env pro Git.

PORT=3000

# Supabase → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "service_role" (secreta! ignora o RLS — só no back-end)
SUPABASE_SERVICE_ROLE_KEY=

# Deadlock API (comunitária). Só mude se o endereço mudar.
DEADLOCK_API_URL=https://api.deadlock-api.com

# Sincroniza heróis/itens ao subir a API (deixe true no primeiro uso)
SYNC_ON_BOOT=true

# Token para POST /admin/sync (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SYNC_TOKEN=

# Origem do front (CORS)
WEB_ORIGIN=http://localhost:4200

# start.gg (opcional: importa partidas de torneios que usam start.gg) → start.gg > Developer Settings > Personal Access Tokens
# O token é SECRETO: só aqui (o content:sync roda no seu PC), nunca no chat nem no Git.
STARTGG_TOKEN=

# Groq: modelo (opcional, padrão openai/gpt-oss-120b) e limite de tokens por minuto (padrão 8000)
GROQ_MODEL=
GROQ_TPM=

# Groq: modelo (opcional, padrão openai/gpt-oss-120b) e limite de tokens por minuto (padrão 8000)
GROQ_MODEL=
GROQ_TPM=

# Login com Steam
# Endereço público do SITE (onde fica o cookie). Local: http://localhost:4200 · Render: https://ddhub-br.vercel.app
PUBLIC_WEB_URL=http://localhost:4200
# Chave da Steam Web API (nome e avatar) → https://steamcommunity.com/dev/apikey — SECRETA
STEAM_API_KEY=
