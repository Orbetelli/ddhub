# Copie este arquivo para .env e preencha. NUNCA suba o .env pro Git.

PORT=3000

# Supabase → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "service_role" (secreta! ignora o RLS — só no back-end)
SUPABASE_SERVICE_ROLE_KEY=

# Deadlock API (comunitária). Só mude se o endereço mudar.
DEADLOCK_API_URL=https://api.deadlock-api.com

# Sincroniza heróis/itens ao subir a API (deixe true no primeiro uso)
SYNC_ON_BOOT=true

# Token para POST /admin/sync (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SYNC_TOKEN=

# Origem do front (CORS)
WEB_ORIGIN=http://localhost:4200
